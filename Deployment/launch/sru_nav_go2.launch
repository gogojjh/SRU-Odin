<?xml version="1.0"?>
<!--
  Launch the SRU navigation controller on Unitree Go2 + Odin1.
  Assumes the Odin1 ROS1 driver and a Go2 cmd_vel bridge are already running
  (or will be launched separately).
-->
<launch>
  <!-- ============================================================== -->
  <!-- Top-level arguments                                              -->
  <!-- ============================================================== -->
  <arg name="sim"               default="false" doc="Treat odom twist as already in base frame."/>

  <!-- 目标点/速度指令话题名，默认跟 config/sru_nav.yaml 里写的一样（独立跑
       纯 SRU 导航、直接控制 /cmd_vel 时用默认值）。给 MarvisNav 当底座时必须
       显式传 goal_topic:=/sru/goal_pose cmd_vel_topic:=/sru/cmd_vel，否则
       SRU 会抢占默认的 /cmd_vel（MarvisNav 执行器 snownav_go2_executor.py(已删的旧执行器)
       要独占 /cmd_vel 的发布权，自己决定何时采纳 SRU 算出的速度），两边
       话题对不上，表现为狗原地打转、几乎不产生位移，且不报任何错误。 -->
  <arg name="goal_topic"        default="/goal_pose"/>
  <arg name="cmd_vel_topic"     default="/cmd_vel"/>
  <!-- 里程计话题。默认吃驱动原生的 odom 系那一路（单独跑纯 SRU 导航时用它）。
       跟 MarvisNav 集成时要换成 /habitat/odom_highfreq —— 那是桥接把同一份 400 Hz
       数据换算到 world 系后转发的。sru_nav_node 拿 odom 消息的 header.frame_id
       当自己的地图系，而 C++ 发的目标点是 world 系的，两边必须是同一个系；
       混用的话目标点会系统性偏一个安装外参（15.8 厘米）且不报错。 -->
  <arg name="odom_topic"        default="/odin1/odometry_highfreq"/>

  <!-- 🔴 sru_nav_node 的解释器必须显式指定。catkin 生成的中继脚本把 configure 时的
       PYTHON_EXECUTABLE(本机是 /usr/bin/python3)写死进 shebang,而 onnxruntime/scipy/cv2
       装在 conda sru_nav 环境里 —— 不覆盖就是 ModuleNotFoundError。先 conda activate
       sru_nav 再 roslaunch,这里自动取 $CONDA_PREFIX;没激活 conda 时回落系统 python。 -->
  <arg name="python_bin"        default="$(optenv CONDA_PREFIX /usr)/bin/python3"/>

  <!-- ============================================================== -->
  <!-- Odin1 装在 Go2 上的外参(机体 -> Odin 的 IMU)                      -->
  <!--                                                                  -->
  <!-- 名词: base_link 是"机体", 原点在**地面上**、机器人正下方;         -->
  <!--       imu 是 Odin1 内部的惯性单元, 也是 Odin 自己那套 odom 的原点  -->
  <!--       所在(驱动发 odom->imu)。                                    -->
  <!--                                                                  -->
  <!-- odin_z=0.625 是**狗站立时** Odin 的 IMU 离地多高。Odin 的 odom     -->
  <!-- 原点定在驱动启动那一刻 IMU 所在的高度, 所以驱动必须在狗站好之后    -->
  <!-- 再起 —— 实测躺->站 z 会跳 0.237 m, 对不上的话地图整体偏这么多,     -->
  <!-- 桌腿椅子垃圾桶全部漏检且什么都不报(桥接会就此打一条 warn)。        -->
  <!--                                                                  -->
  <!-- 2026-09-30 支架改动:雷达往 z 方向(离地高度)抬高约 21 cm、往 y     -->
  <!-- 方向(机器人左侧)移动约 4 cm(卷尺粗测)。当天上机后用点云主峰法    -->
  <!-- (floor_from_cloud.py)精标 odin_z:两次独立跑分毫不差都是 0.625,   -->
  <!-- 主峰占比 74~75%(一枝独秀)、3 米内截断同一峰,判据全绿,取 0.625   -->
  <!-- (比卷尺粗测的 0.651 精确,差 2.6 cm 在粗测误差范围内)。odin_y     -->
  <!-- 目前没有对应的传感器标定方法,仍是卷尺粗测的 0.04,未精标。         -->
  <!--                                                                  -->
  <!-- odin_pitch = 0.009947 rad = 0.570 度, 是**支架改动后**当天的实测   -->
  <!-- 值(2026-09-30,狗已站好,与 odin_z 同一趟标定):让狗四脚站在水平    -->
  <!-- 地面上, rostopic echo -n1 /odin1/odometry, 把四元数转成俯仰角,    -->
  <!-- 连采 5 帧, 标准差仅 0.000016 rad, 远超"稳定到小数点后三位"的要求。 -->
  <!-- 旧值 -0.012462 rad(支架改动前)已作废——注意这次连符号都变了,      -->
  <!-- 说明改动后俯仰方向确实反了过来,不是"大概率不变"。支架再动过        -->
  <!-- 要照这个方法重测。                                                -->
  <!-- (旧文档里的 2 度、0.349 rad 都不是实测值, 前者是估的, 后者是从     -->
  <!--  ZED X 相机配置继承下来的, 均已作废。)                            -->
  <!-- ============================================================== -->
  <arg name="odin_x"     default="0.1582"/>
  <arg name="odin_y"     default="0.04"/> <!-- 卷尺粗测,未精标 -->
  <arg name="odin_z"     default="0.625"/>
  <arg name="odin_pitch" default="0.009947"/>

  <!-- ============================================================== -->
  <!-- 外参 TF 两条。static_transform_publisher 的角度参数顺序是          -->
  <!-- x y z yaw pitch roll。                                            -->
  <!--                                                                  -->
  <!-- (1) world -> odom : **旋转必须是单位阵**。                        -->
  <!--     实测证明 Odin 的 odom 系是重力对齐的 —— 由                    -->
  <!--     /odin1/imu 的重力向量算出的倾角与 /odin1/odometry 报的姿态     -->
  <!--     数值一致、符号相反(狗躺着 +4.80 vs -4.93 度; 站着 +0.58 vs     -->
  <!--     -0.714 度)。也就是说安装倾角已经含在驱动发的 odom->imu 里了。  -->
  <!--     而 world(地面上的机体系)也是水平的, 两个重力对齐的系只可能差   -->
  <!--     一个平移加偏航。再往这里放俯仰就是把同一个倾角计两次,          -->
  <!--     地板估计会系统性偏斜(4 米外差约 14 厘米)。                     -->
  <!--                                                                  -->
  <!-- (2) imu -> base_link : 安装倾角只出现在这一条里。                  -->
  <!--     数值 = base_link->imu 取逆, 即 T(0.1582,0.04,0.625)*Ry(0.570度) -->
  <!--     的逆。挂成 imu->base_link 而不是反过来, 是因为驱动已经在发      -->
  <!--     odom->imu, 反挂会造成 imu 双父冲突。                          -->
  <!--     平移是按 -R(pitch)^T * t 算出来的, 已验算级联回单位阵。改了     -->
  <!--     上面的 odin_* 就要重算这三个数(tools 里没有现成脚本, 手算即可)。 -->
  <!--     2026-09-30 按支架改动后当天实测的 odin_z / odin_pitch 重算:    -->
  <!--     旧(支架改动前): (-0.163683, 0.0, -0.438994), pitch 0.012462   -->
  <!--     新(支架改动后实测): (-0.151975, -0.04, -0.626543), pitch      -->
  <!--     -0.009947(= -odin_pitch)。                                   -->
  <!--                                                                  -->
  <!-- 改完的 TF 树: world -> odom -> imu -> {lidar, base_link},         -->
  <!--               旁支 odom -> camera_0 (后三条由驱动动态发)。         -->
  <!-- ============================================================== -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_odom"
        args="$(arg odin_x) $(arg odin_y) $(arg odin_z) 0 0 0 world odom"/>

  <node pkg="tf2_ros" type="static_transform_publisher" name="imu_to_base_link"
        args="-0.151975 -0.04 -0.626543 0 -0.009947 0 imu base_link"/>

  <!-- 相机内参(/odin1/camera_info)不在这里发 —— 那是 Odin1 自己的传感器信息,
       跟着驱动一起起更合理(odin_ros_driver/launch_ROS1/odin1_ros1*.launch 里的
       odin_camera_info_pub)。这样只跑驱动、不跑导航时也有内参。 -->

  <!-- ============================================================== -->
  <!-- SRU navigation node                                              -->
  <!-- ============================================================== -->
  <node pkg="sru_nav_go2_ros1" type="sru_nav_node" name="sru_nav_node"
        output="screen" required="true" launch-prefix="$(arg python_bin)">
    <rosparam command="load" file="$(find sru_nav_go2_ros1)/config/sru_nav.yaml"/>
    <param name="use_sim"          value="$(arg sim)"/>
    <!-- 放在 rosparam load 之后才能盖住 yaml 里写死的 /goal_pose、/cmd_vel -->
    <param name="goal_topic"       value="$(arg goal_topic)"/>
    <param name="cmd_vel_topic"    value="$(arg cmd_vel_topic)"/>
    <param name="odom_topic"       value="$(arg odom_topic)"/>
  </node>
</launch>
